# Migração da configuração antiga da conta principal. Novas contas devem cadastrar
# suas próprias chaves somente leitura na aba Contas; o servidor as criptografa por usuário.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Banco PostgreSQL persistente (obrigatório na Vercel; conexão Neon via Marketplace).
DATABASE_URL=

# Pluggy Open Finance: obtenha estas credenciais no painel de desenvolvedor Pluggy.
# Elas ficam somente no servidor e não devem ser compartilhadas no navegador ou chat.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# Opcional em localhost: no primeiro início, o servidor gera uma chave local em .local/app-encryption.key.
# Em produção, defina uma chave Base64 aleatória de 32 bytes e faça backup seguro dela.
APP_ENCRYPTION_KEY=
# Configure o mesmo valor como header X-Webhook-Secret no webhook da Pluggy.
# O webhook exige uma URL HTTPS pública; localhost não é acessível pela Pluggy.
PLUGGY_WEBHOOK_SECRET=

# Recuperação e verificação por e-mail. Gmail: use uma senha de app em SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Alternativa opcional ao SMTP: Resend com remetente verificado.
RESEND_API_KEY=

# O servidor liga somente em localhost por padrão.
# Em produção, use NODE_ENV=production, DATABASE_URL e APP_ENCRYPTION_KEY.
# A Vercel fornece VERCEL_URL; use PUBLIC_ORIGIN apenas quando configurar domínio próprio.
NODE_ENV=development
PUBLIC_ORIGIN=
HOST=127.0.0.1
PORT=4173

# Notificações pela WhatsApp Business Platform (Meta Cloud API).
# Crie um modelo aprovado com 5 variáveis no corpo: tipo, descrição, valor, data, origem.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TRANSACTION_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_GRAPH_API_VERSION=v23.0
