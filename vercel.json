{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "functions": {
    "api/**/*.ts": { "includeFiles": "dashboard.html" }
  },
  "rewrites": [
    { "source": "/api/:path*", "missing": [{ "type": "query", "key": "path" }], "destination": "/api/home?path=/api/:path*" },
    { "source": "/", "destination": "/api/home?path=/" },
    { "source": "/login", "destination": "/api/home?path=/login" },
    { "source": "/register", "destination": "/api/home?path=/register" },
    { "source": "/forgot-password", "destination": "/api/home?path=/forgot-password" }
  ]
}
