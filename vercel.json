{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "rewrites": [
    { "source": "/login", "destination": "/api/site?path=/login" },
    { "source": "/register", "destination": "/api/site?path=/register" },
    { "source": "/forgot-password", "destination": "/api/site?path=/forgot-password" }
  ]
}
